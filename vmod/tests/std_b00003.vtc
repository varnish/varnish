vtest "test vmod_std.collect()"

server s1 {
	rxreq
	expect req.http.foo == "1, 2"
	expect req.http.baz == "0, 3, 4"
	txresp -hdr "bar: a" -hdr "bar: b" -hdr "qux: c" -hdr "qux: d"
} -start

varnish v1 -vcl+backend {
	import std;

	sub vcl_recv {
		std.collect(req.http.foo);
	}
	sub vcl_hash {
		hash_data("/");
		return (lookup);
	}
	sub vcl_hit {
		if (req.url == "/obj") {
			std.collect(obj.http.foo);
		}
	}
	sub vcl_backend_fetch {
		std.collect(bereq.http.baz);
	}
	sub vcl_backend_response {
		std.collect(beresp.http.bar);
	}
	sub vcl_deliver {
		std.collect(resp.http.qux, "; ");
	}
} -start

logexpect l1 -v v1 -q "ReqURL ~ \"^/$\"" {
	fail add *	End
	expect * *	VCL_call	{^RECV}
	expect 0 *	ReqUnset	{^Foo: 1}
	expect 0 *	ReqUnset	{^foo: 2}
	expect 0 *	ReqHeader	{^Foo: 1, 2}
	fail clear
} -start

logexpect l2 -v v1 -q "BereqURL ~ \"^/$\"" {
	fail add *	End
	expect * *	VCL_call	{^BACKEND_FETCH}
	expect 0 *	BereqUnset	{^Baz: 0}
	expect 0 *	BereqUnset	{^Baz: 3}
	expect 0 *	BereqUnset	{^bAZ: 4}
	expect 0 *	BereqHeader	{^Baz: 0, 3, 4}
	fail clear
} -start

client c1 {
	txreq -hdr "Foo: 1" -hdr "Fo: X" -hdr "Baz: 0" -hdr "Bazz: A" -hdr "Fooo: B" -hdr "foo: 2" -hdr "Baz: 3" -hdr "bAZ: 4"
	rxresp
	expect resp.http.bar == "a, b"
	expect resp.http.qux == "c; d"
	txreq -url "/obj"
	rxresp
	expect resp.status == 503
} -run

logexpect l1 -wait
logexpect l2 -wait
