vtest "Test bogus Content-Length header"

server s1 {
	rxreq
	txresp -nolen -hdr "Content-Length: bogus"
} -start

varnish v1 -vcl+backend {

} -start

logexpect l1 -v v1 -g vxid -q "vxid == 1002" {
	expect * 1002	BogoHeader	{^Invalid Content-Length$}
	expect 0 =	BerespStatus	{^503$}
	expect 0 =	BerespReason	{^Service Unavailable$}
	expect 0 =	FetchError	{^http format error$}
} -start

client c1 {
	txreq
	rxresp
} -run

logexpect l1 -wait
