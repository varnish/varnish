varnishtest "-sdisk: bans, vary, ESI and expiry across a restart"

server s1 {
	rxreq
	expect req.url == "/banned"
	txresp -body "banned"

	rxreq
	expect req.url == "/kept"
	txresp -body "kept"

	rxreq
	expect req.url == "/vary"
	expect req.http.lang == "en"
	txresp -hdr "Vary: lang" -body "english"

	rxreq
	expect req.url == "/vary"
	expect req.http.lang == "no"
	txresp -hdr "Vary: lang" -body "norsk"

	rxreq
	expect req.url == "/esi"
	txresp -body {<a><esi:include src="/kept"/><b>}

	rxreq
	expect req.url == "/short"
	txresp -hdr "Cache-Control: max-age=1" -body "short"
} -start

varnish v1 -arg "-sdisk=disk,${tmpdir}/_.disk,20m" \
    -arg "-p default_grace=0" -arg "-p default_keep=0" -vcl+backend {
	sub vcl_backend_response {
		if (bereq.url == "/esi") {
			set beresp.do_esi = true;
		}
	}
} -start

client c1 {
	txreq -url "/banned"
	rxresp
	expect resp.body == "banned"
	txreq -url "/kept"
	rxresp
	expect resp.body == "kept"
	txreq -url "/vary" -hdr "lang: en"
	rxresp
	expect resp.body == "english"
	txreq -url "/vary" -hdr "lang: no"
	rxresp
	expect resp.body == "norsk"
	txreq -url "/esi"
	rxresp
	expect resp.body == "<a>kept<b>"
	txreq -url "/short"
	rxresp
	expect resp.body == "short"
} -run

varnish v1 -cliok "ban req.url == /banned"

# Let /short expire while we are down
delay 1.5
varnish v1 -stop
varnish v1 -start
# /short was expired at shutdown, only five were saved
varnish v1 -expect DISK.disk.c_restored == 5

server s1 -wait
server s1 {
	rxreq
	expect req.url == "/banned"
	txresp -body "refetched"
	rxreq
	expect req.url == "/short"
	txresp -body "short again"
} -start

client c2 {
	# The ban from before the restart still applies
	txreq -url "/banned"
	rxresp
	expect resp.body == "refetched"

	txreq -url "/kept"
	rxresp
	expect resp.body == "kept"
	expect resp.http.X-Varnish != "1"

	txreq -url "/vary" -hdr "lang: no"
	rxresp
	expect resp.body == "norsk"
	txreq -url "/vary" -hdr "lang: en"
	rxresp
	expect resp.body == "english"

	txreq -url "/esi"
	rxresp
	expect resp.body == "<a>kept<b>"

	txreq -url "/short"
	rxresp
	expect resp.body == "short again"
} -run

varnish v1 -cliok "ban.list"
