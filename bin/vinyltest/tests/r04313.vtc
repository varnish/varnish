vtest "storage failure with synthetic body"

varnish v1 -vcl {
	import vtc;

	backend none none;

	sub vcl_init {
		vtc.storage_maxspace(storage.Transient, 32B);
	}
	sub vcl_recv {
		return(pass);
	}

	# avoid the client side running into the same storage failure
	sub vcl_synth {
		set resp.body = resp.reason;
		return(deliver);
	}

	sub vcl_recv {
		return(pass);
	}

	sub vcl_backend_error {
		set beresp.status = 200;
		set beresp.body =
			"0123456789abcdef" +
			"0123456789abcdef" +
			"X";
		return (deliver);
	}
} -start

logexpect l1 -v v1 -q "vxid == 1002" {
	fail add *	End
	expect * * Storage	{^malloc Transient}
	expect * = Debug	{^vtc.storage_maxspace: want 33 canalloc 32}
	expect * = Debug	{^vtc.storage_maxspace: extend 32 canalloc 32}
	expect * = Debug	{^vtc.storage_maxspace: want 1 canalloc 0}
	expect * = FetchError	{^Could not get storage}
	fail clear
} -start

client c1 {
	txreq
	rxresp
	expect resp.status == 503
} -run

logexpect l1 -wait
