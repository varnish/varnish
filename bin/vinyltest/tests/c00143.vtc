vtest "test ban obj.uncacheable"

server s0 {
	rxreq
	txresp -bodylen 5
} -dispatch

varnish v1 -vcl+backend {
	sub vcl_deliver {
		set resp.http.X-hitmiss = req.is_hitmiss;
		set resp.http.X-hitpass = req.is_hitpass;
		set resp.http.X-hit = (obj.hits != 0);
	}

	sub vcl_backend_response {
		if (bereq.url ~ "^/hfp") {
			return (pass(1h));
		}
		if (bereq.url ~ "^/hfm") {
			set beresp.uncacheable = true;
		}
		set beresp.ttl = 1h;
	}
} -start


# obj.hfm only accepts == and !=
varnish v1 -clierr 106 "ban obj.uncacheable > true"
varnish v1 -clierr 106 "ban obj.uncacheable ~ true"
# and only the true/false arguments
varnish v1 -clierr 106 "ban obj.uncacheable == maybe"
varnish v1 -clierr 106 "ban obj.uncacheable != 1"


varnish v1 -cliok "param.set ban_lurker_age 0"
varnish v1 -cliok "param.set ban_lurker_sleep 0.01"

# Hit-for-miss object: obj.uncacheable is true.

client c1 {
	txreq -url "/hfm1"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitmiss == false
	expect resp.http.X-hitpass == false
	expect resp.http.X-hit == false
} -run

varnish v1 -expect n_object == 1

# Hit-for-pass object: obj.uncacheable is true.

client c1 {
	txreq -url "/hfp1"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitmiss == false
	expect resp.http.X-hitpass == false
	expect resp.http.X-hit == false
} -run

varnish v1 -expect n_object == 2

# Neither of these matches a hit-for-miss or hit-for-pass object.
varnish v1 -cliok "ban obj.uncacheable == false"
varnish v1 -cliok "ban obj.uncacheable != true"
varnish v1 -expect bans_lurker_obj_killed == 0
varnish v1 -expect n_object == 2

client c1 {
	txreq -url "/hfp1"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitmiss == false
	expect resp.http.X-hitpass == true
	expect resp.http.X-hit == false
} -run

# This one matches and kills both
varnish v1 -cliok "ban obj.uncacheable == true"
varnish v1 -expect bans_lurker_obj_killed == 2
varnish v1 -expect n_object == 0


client c1 {
	txreq -url "/hfm1"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitmiss == false
	expect resp.http.X-hit == false
} -run


client c1 {
	txreq -url "/hfp1"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitmiss == false
	expect resp.http.X-hitpass == false
	expect resp.http.X-hit == false
} -run

# Another hit-for-miss object, this time killed by "!= false".

client c2 {
	txreq -url "/hfm2"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitpass == false
	expect resp.http.X-hitmiss == false
	expect resp.http.X-hit == false
} -run


client c2 {
	txreq -url "/hfp2"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitmiss == false
	expect resp.http.X-hitpass == false
	expect resp.http.X-hit == false
} -run

varnish v1 -expect n_object == 4
varnish v1 -cliok "ban obj.uncacheable != false"
varnish v1 -expect bans_lurker_obj_killed == 6
varnish v1 -expect n_object == 0

# Regular cacheable object killed by "== false".
client c3 {
	txreq -url "/cache1"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitmiss == false
	expect resp.http.X-hit == false
} -run

varnish v1 -expect n_object == 1

# Neither of these matches a cacheable object.
varnish v1 -cliok "ban obj.uncacheable == true"
varnish v1 -cliok "ban obj.uncacheable != false"
varnish v1 -expect bans_lurker_obj_killed == 6
varnish v1 -expect n_object == 1

client c3 {
	txreq -url "/cache1"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitmiss == false
	expect resp.http.X-hit == true
} -run

# This one matches
varnish v1 -cliok "ban obj.uncacheable == false"
varnish v1 -expect bans_lurker_obj_killed == 7
varnish v1 -expect n_object == 0

client c3 {
	txreq -url "/cache1"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitmiss == false
	expect resp.http.X-hit == false
} -run

# Another cacheable object, this time killed by "!= true".

client c4 {
	txreq -url "/cache2"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitmiss == false
	expect resp.http.X-hit == false
} -run

varnish v1 -expect n_object == 2

client c4 {
	txreq -url "/cache2"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitmiss == false
	expect resp.http.X-hit == true
} -run

varnish v1 -cliok "ban obj.uncacheable != true"
varnish v1 -expect bans_lurker_obj_killed == 9
varnish v1 -expect n_object == 0


client c4 {
	txreq -url "/cache2"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitmiss == false
	expect resp.http.X-hit == false
} -run
