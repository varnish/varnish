varnishtest "-sdisk: content survives a clean restart, not a crash"

server s1 {
	rxreq
	expect req.url == "/small"
	txresp -hdr "Foo: small" -body "small body"

	rxreq
	expect req.url == "/large"
	txresp -hdr "Foo: large" -bodylen 1000000

	rxreq
	expect req.url == "/chunked"
	txresp -nolen -hdr "Transfer-Encoding: chunked"
	chunkedlen 70000
	chunkedlen 70000
	chunkedlen 0

	rxreq
	expect req.url == "/nobody"
	txresp -status 204
} -start

varnish v1 -arg "-sdisk=disk,${tmpdir}/_.disk,20m" -vcl+backend {
	sub vcl_backend_response {
		set beresp.ttl = 1h;
	}
} -start

client c1 {
	txreq -url "/small"
	rxresp
	expect resp.status == 200
	expect resp.http.foo == "small"
	expect resp.body == "small body"

	txreq -url "/large"
	rxresp
	expect resp.status == 200
	expect resp.bodylen == 1000000

	txreq -url "/chunked"
	rxresp
	expect resp.status == 200
	expect resp.bodylen == 140000

	txreq -url "/nobody"
	rxresp
	expect resp.status == 204
} -run

# Hits from the disk before any restart
client c2 {
	txreq -url "/large"
	rxresp
	expect resp.http.X-Varnish == "1010 1004"
	expect resp.bodylen == 1000000
} -run

varnish v1 -expect DISK.disk.c_restored == 0
varnish v1 -stop
varnish v1 -start
varnish v1 -expect DISK.disk.c_restored == 4
varnish v1 -cliok "debug.xid 2000"

# Same content, now served from the restored index
client c3 {
	txreq -url "/small"
	rxresp
	expect resp.status == 200
	expect resp.http.foo == "small"
	expect resp.body == "small body"
	expect resp.http.X-Varnish == "2001 1002"

	txreq -url "/large"
	rxresp
	expect resp.http.foo == "large"
	expect resp.bodylen == 1000000

	txreq -url "/chunked"
	rxresp
	expect resp.bodylen == 140000

	txreq -url "/nobody"
	rxresp
	expect resp.status == 204
} -run

# A second clean restart works too
varnish v1 -stop
varnish v1 -start
varnish v1 -expect DISK.disk.c_restored == 4

# A crash forfeits everything
varnish v1 -cliok "param.set feature +no_coredump"
varnish v1 -clierr 400 "debug.panic.worker"
delay 0.5
varnish v1 -cliok "panic.clear"
varnish v1 -start
varnish v1 -expect DISK.disk.c_restored == 0

server s1 {
	rxreq
	expect req.url == "/small"
	txresp -hdr "Foo: refetched" -body "new"
} -start

client c4 {
	txreq -url "/small"
	rxresp
	expect resp.http.foo == "refetched"
	expect resp.body == "new"
} -run

varnish v1 -expectexit 0x40
