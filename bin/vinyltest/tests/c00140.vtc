vtest "Chunked stress"

server s0 {
	rxreq
	txresp -nolen -hdr "Transfer-Encoding: chunked"
	loop 1024 {
		chunkedlen 64
	}
	chunkedlen 0
} -dispatch

varnish v1 -vcl+backend {
	sub vcl_recv {
		return (pass);
	}
} -start

client c1 {
	txreq
	rxresp
} -start
client c2 {
	txreq
	rxresp
} -start
client c1 -wait
client c2 -wait
