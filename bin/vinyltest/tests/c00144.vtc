vtest "VSM reader reports malformed _.index lines"

varnish v1 -vcl {
	backend default none;
} -start

delay 0.5

# Make a minimal twin of v1 to experiment with
shell {
	mkdir -p ${tmpdir}/twin
	cp -a ${tmpdir}/v1/_.vsm_mgt ${tmpdir}/twin
}

# Garbage in _.index

filewrite -a ${tmpdir}/twin/_.vsm_mgt/_.index {Hello World
}

shell -expect {Malformed _.index line (9): Unknown ident} -exit 2 {
	varnishstat -n ${tmpdir}/twin -t 1 -1 > ${tmpdir}/_out
}

# VAV_parse errors in _.index

shell {cp ${tmpdir}/v1/_.vsm_mgt/_.index ${tmpdir}/twin/_.vsm_mgt}
filewrite -a ${tmpdir}/twin/_.vsm_mgt/_.index {+ "_.Dictionary.badname.deadbeef 0 16 Dictionary x
}

shell -expect {Malformed _.index line (9): Missing '"'} -exit 2 {
	varnishstat -n ${tmpdir}/twin -t 1 -1 > ${tmpdir}/_out
}

# Wrong number of fields in _.index

shell {cp ${tmpdir}/v1/_.vsm_mgt/_.index ${tmpdir}/twin/_.vsm_mgt}
filewrite -a ${tmpdir}/twin/_.vsm_mgt/_.index {+ _.Dictionary.bad na me.deadbeef 0 16 Dictionary x
}

shell -expect {Malformed _.index line (9): Wrong number of fields (7)} -exit 2 {
	varnishstat -n ${tmpdir}/twin -t 1 -1 > ${tmpdir}/_out
}

shell {rm -rf ${tmpdir}/twin}
