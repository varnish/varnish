vtest "#4614: bgfetch with transit_buffer causes hanging fetch threads"

server s1 {
	rxreq
	txresp	-hdr "Last-Modified: Tue, 16 Jan 2024 16:13:33 GMT" \
		-hdr "Cache-Control: max-age=1" \
		-bodylen 42

	rxreq
	expect req.http.If-Modified-Since == "Tue, 16 Jan 2024 16:13:33 GMT"
	txresp	-hdr "Last-Modified: Tue, 16 Jan 2024 16:13:34 GMT" \
		-hdr "Cache-Control: private" \
		-bodylen 20480
} -start

varnish v1 -cliok "param.set transit_buffer 1k"
varnish v1 -vcl+backend { } -start

client c1 {
	txreq
	rxresp
	expect resp.status == 200

	delay 2

	txreq
	rxresp
	expect resp.status == 200
} -run

varnish v1 -expect VBE.vcl1.s1.conn == 0
varnish v1 -expect VBE.vcl1.s1.busy == 0
