vtest "Duplicate Transfer-Encoding field lines are faulty framing"

# RFC 9110 5.3 makes repeated field lines one list, but we judged only the
# first, so a leading chunked framed the message.

server s1 {
	rxreq
	txresp -bodylen 3
} -start

server s2 {
	rxreq
	send "HTTP/1.1 200 OK\r\n"
	send "Transfer-Encoding: chunked\r\nTransfer-Encoding: identity\r\n\r\n"
	send "5\r\nhello\r\n0\r\n\r\n"
} -start

varnish v1 -vcl+backend {
	sub vcl_backend_fetch {
		if (bereq.url == "/3") {
			set bereq.backend = s2;
		}
	}
} -start

client c1 {
	send "POST /1 HTTP/1.1\r\nHost: foo\r\n"
	send "Transfer-Encoding: chunked\r\nTransfer-Encoding: identity\r\n\r\n"
	send "5\r\nhello\r\n0\r\n\r\n"
	rxresp
	expect resp.status == 400
	expect_close
} -run

varnish v1 -expect client_req_400 == 1

client c2 {
	txreq -req POST -url /2 -nolen -hdr "Transfer-Encoding: chunked"
	chunkedlen 5
	chunkedlen 0
	rxresp
	expect resp.status == 200
} -run

varnish v1 -expect backend_recycle == 1

client c3 {
	txreq -url /3
	rxresp
	expect resp.status == 503
} -run

varnish v1 -expect fetch_failed == 1
varnish v1 -expect backend_recycle == 1
