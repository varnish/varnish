vtest "HEAD + range header"

server s1 {
        rxreq
        txresp -bodylen 1024
} -start

varnish v1 -vcl+backend { } -start

client c1 {
        txreq -req HEAD -hdr "Range: bytes=11-40"
        rxresp -no_obj
        expect resp.status == 200
        expect resp.http.content-length == 1024
        expect resp.http.content-range == <undef>
} -run
