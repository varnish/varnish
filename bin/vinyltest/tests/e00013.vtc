vtest "All white-space object, in multiple storage segments"

server s1 {
	rxreq
	expect req.url == "/foo"
	txresp -nolen -hdr "Transfer-Encoding: chunked"
	chunked {<x>                                      }
	chunkedlen 0
} -start

varnish v1 -vcl+backend {
	import vtc;
	sub vcl_init {
		vtc.storage_frag(storage.s0, 4B);
	}
	sub vcl_backend_response {
		set beresp.do_esi = true;
	}
} -start

client c1 {
	txreq -url /foo
	rxresp
} -run

varnish v1 -expect esi_errors == 0
