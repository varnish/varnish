vtest "trivial run of varnishadm in script mode"

feature cmd "python3 -c 'import json'"

varnish v1 -vcl {backend be none;} -start

process p1 -log {varnishadm -n ${v1_name} status} -start
process p1 -expect-text 1 1 "Child in state running"
process p1 -wait

process p1 -log {varnishadm -n ${v1_name}} -start
process p1 -write "status\r"
process p1 -expect-text 0 1 "200"
process p1 -expect-text 0 1 "Child in state running"
process p1 -write "quit\r"
process p1 -wait

# -p option
process p1 -log {varnishadm -n ${v1_name} -p status} -start
process p1 -expect-text 1 1 "200 22"
process p1 -expect-text 2 1 "Child in state running"
process p1 -wait

process p1 -log {varnishadm -n ${v1_name} -p} -start
process p1 -write "status\r"
process p1 -expect-text 2 1 "200 22"
process p1 -expect-text 3 1 "Child in state running"
process p1 -close -wait

process p1 -log {
	varnishadm -n ${v1_name} status -j |
	python3 -c 'import sys, json; print(json.load(sys.stdin))'
} -start
process p1 -expect-text 0 1 "[2, ['status', '-j'],"
process p1 -expect-text 0 0 ", 'running']"
process p1 -wait


process p2 -log {varnishadm -n ${v1_name} | cat} -start
process p2 -write "status -j\n"
process p2 -expect-text 0 0 {[ 2, ["status", "-j"],}
process p2 -expect-text 0 0 {, "running"}
process p2 -close -wait
