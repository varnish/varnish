vtest "Test boolean parameters work without stdbool.h in vgc.c"

server s1 {
	rxreq
	txresp
} -start

varnish v1 -vcl+backend {
	import debug;

	sub vcl_init {
		debug.test_default_bool();
		debug.test_default_bool(false);
		debug.test_default_bool(true);
	}
} -start

client c1 {
	txreq
	rxresp
} -run
