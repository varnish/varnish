vtest	"Direct H2 start on a reused HTTP/1 connection"

server s1 {
	rxreq
	expect req.url == /h1
	txresp -bodylen 5

	rxreq
	expect req.url == /h2
	txresp -bodylen 7
} -start

varnish v1 -vcl+backend {} -start

varnish v1 -cliok "param.set feature +http2"
varnish v1 -cliok "param.set debug +syncvsl"

# A prism can arrive on a connection that has already served HTTP/1
# requests. The session must not inherit anything from them.

client c1 {
	send "GET /h1 HTTP/1.1\r\n"
	send "Host: foo.bar\r\n"
	send "\r\n"
	rxresp
	expect resp.status == 200
	expect resp.bodylen == 5

	txpri
	stream 0 {
		txsettings
		rxsettings
		expect settings.ack == false
		txsettings -ack
		rxsettings
		expect settings.ack == true
	} -run

	stream 1 {
		txreq -url /h2 -hdr "host" "foo.bar"
		rxresp
		expect resp.status == 200
		expect resp.bodylen == 7
	} -run
} -run

varnish v1 -vsl_catchup

varnish v1 -expect MEMPOOL.req0.live == 0
varnish v1 -expect MEMPOOL.req1.live == 0
varnish v1 -expect MEMPOOL.sess0.live == 0
varnish v1 -expect MEMPOOL.sess1.live == 0
