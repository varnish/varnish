vtest "#1287 - check NULL as input to resp.body"

server s1 {
} -start

varnish v1 -vcl+backend {
	sub vcl_recv {
		return (synth(200, "OK"));
	}
	sub vcl_synth {
		set resp.body = resp.http.blank;
		return (deliver);
	}
} -start

client c1 {
	txreq
	rxresp
	expect resp.status == 200
	expect resp.body == ""
} -run
