vtest "Varnishtest coverage"

# Cover usage processing
shell -err -expect {usage:} {
	varnishtest -v -l
}

# Cover argument processing
shell {
	echo 'vtest foo' > ${tmpdir}/_.vtc
	varnishtest -j 4 -n 10 -C -v -b 100k -L -l ${tmpdir}/_.vtc
	ls -l ${tmpdir}
}

shell -err -expect {No such file or directory} {
	rm -f ${tmpdir}/_.vtc
	env VTEST_DURATION=15 \
	    varnishtest -j 4 -n 10 -C -v -b 100k -L -l ${tmpdir}/_.vtc
}

# Hit varnish_fatal

shell -err -expect {Unknown varnish argument: -cause-a-scene} {
	cat > ${tmpdir}/_.vtc <<- EOF
	vtest foo
	varnish v1 -cause-a-scene
	EOF
	varnishtest -v ${tmpdir}/_.vtc
}
