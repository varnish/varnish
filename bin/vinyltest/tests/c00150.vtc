vtest "Transfer-Encoding on an HTTP/1.0 message"

# RFC 9112 6.1 faulty framing on HTTP/1.0.  A request is refused before
# VCL, a response by the builtin VCL, which a VCL returning first keeps.

server s1 {
	rxreq
	txresp -bodylen 5
} -start

server s2 {
	rxreq
	send "HTTP/1.0 200 OK\r\n"
	send "Transfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"
} -start

server s3 {
	rxreq
	send "HTTP/1.0 200 OK\r\n"
	send "Transfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"
} -start

varnish v1 -vcl+backend {
	sub vcl_backend_fetch {
		if (bereq.url == "/3") {
			set bereq.backend = s2;
		}
		elseif (bereq.url == "/4") {
			set bereq.backend = s3;
		}
	}
	sub vcl_backend_response {
		if (bereq.url == "/4") {
			return (deliver);
		}
	}
} -start

client c1 {
	send "POST /1 HTTP/1.0\r\nHost: foo\r\nConnection: keep-alive\r\n"
	send "Transfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"
	rxresp
	expect resp.status == 400
	expect_close
} -run

client c2 {
	txreq -req POST -url /2 -nolen -hdr "Transfer-Encoding: chunked"
	chunkedlen 5
	chunkedlen 0
	rxresp
	expect resp.status == 200
} -run

varnish v1 -expect client_req_400 == 1
varnish v1 -expect sc_rx_junk == 1

client c3 {
	txreq -url /3
	rxresp
	expect resp.status == 503
} -run

varnish v1 -expect fetch_failed == 0

client c4 {
	txreq -url /4
	rxresp
	expect resp.status == 200
	expect resp.bodylen == 5
} -run
